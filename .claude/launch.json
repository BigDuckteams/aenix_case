{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m", "uv", "run", "--project", "backend",
        "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "dev"],
      "port": 3000
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "dev:mock", "--port", "3100"],
      "port": 3100
    }
  ]
}
